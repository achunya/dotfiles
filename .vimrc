" --- Basic Settings ---
set nocompatible              " Be iMproved, not Vi
syntax enable                 " Enable syntax highlighting
filetype plugin indent on     " Enable file type detection, plugins, and indenting

" --- UI Improvements ---
set number                    " Show line numbers
set relativenumber            " Show relative line numbers for easier navigation
set ignorecase                " Ignore case when searching
set hlsearch                  " Highlight search matches

" --- Indentation ---
set expandtab                 " Use spaces instead of tabs
set smartindent               " Intelligent auto-indenting
set tabstop=4                 " Number of spaces a <Tab> counts for
set shiftwidth=4              " Number of spaces used for auto-indent and shifting
set smarttab

" --- Quality of Life ---
set undofile                  " Persist undo history across sessions
set hidden                    " Allow unsaved buffers to be hidden

