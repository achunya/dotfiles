{
  "layer": "top",
  "position": "top",
  "modules-left": [ "custom/arch", "niri/window", "niri/language" ],
  "modules-center": [ "clock" , "custom/playerctl" ],
  "modules-right": [ "cpu", "memory", "pulseaudio", "backlight", "custom/batteries", "tray" , "custom/swaync"],

  "custom/arch": {
    "format": "",
    "tooltip": false,
    "on-click": "rofi -show drun",
    "interval": 0
  },

  "niri/window": {
    "format": "{title}",
    "max-length": 15
  },

  "niri/language": {
    "format-en": "us",
    "format-ru": "ru",
    "tooltip": false,
    "on-click": "hyprctl switchxkblayout 0 next",
    "interval": 1
  },

  "clock": {
    "format": " {:%H:%M}",
    "tooltip-format": " {:%A, %B %d, %Y}",
    "interval": 60
  },

  "custom/playerctl": {
    "exec": "playerctl metadata --format '{{ artist }} - {{ title }}' | cut -c1-40 || echo 'No Music'",
    "interval": 2,
    "max-length": 30,
    "on-click-middle": "playerctl play-pause",
    "on-click-right": "playerctl next",
    "on-click": "playerctl previous"
  },

  "cpu": {
    "format": " {usage}%"
  },

  "memory": {
    "format": " {used}MB"
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": " muted",
    "format-icons": {
      "default": ["", "", ""]
    },
    "on-click": "pavucontrol"
  },

  "backlight": {
    "format": " {percent}%",
    "on-scroll-up": "brightnessctl set +5%",
    "on-scroll-down": "brightnessctl set 5%-"
  },

  "custom/batteries": {
    "exec": "~/.config/niri/scripts/battery.sh",
    "interval": 2,
    "return-type": "json"
  },

  "network": {
    "format-wifi": "  {essid}",
    "format-ethernet": "󰈁  Wired",
    "format-disconnected": "󰖪  Disconnected",
    "interval": 10,
    "tooltip": true,
    "on-click": "kitty nmtui"
  },

  "tray": {
    "icon-size": 18,
    "spacing": 4
  },

  "custom/swaync": {
    "tooltip": false,
    "format": "{} {icon}",
    "format-icons": {
      "notification": "󱅫",
      "none": "",
      "dnd-notification": " ",
      "dnd-none": "󰂛",
      "inhibited-notification": " ",
      "inhibited-none": "",
      "dnd-inhibited-notification": " ",
      "dnd-inhibited-none": " "
    },
    "return-type": "json",
    "exec-if": "which swaync-client",
    "exec": "swaync-client -swb",
    "on-click": "sleep 0.1 && swaync-client -t -sw",
    "on-click-right": "sleep 0.1 && swaync-client -d -sw",
    "escape": true
  }
}

